{
  "id": "/",
  "name": "CodeMini IDE",
  "short_name": "CodeMini",
  "description": "Offline-first lightweight browser IDE.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#fdfdfd",
  "theme_color": "#ffffff",
  "categories": [
    "development",
    "productivity"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New File",
      "short_name": "New File",
      "description": "Create a new file in this workspace",
      "url": "/?action=new-file"
    },
    {
      "name": "Open Terminal",
      "short_name": "Terminal",
      "description": "Open the integrated terminal",
      "url": "/?action=terminal"
    },
    {
      "name": "Search Workspace",
      "short_name": "Search",
      "description": "Search across your files",
      "url": "/?action=search"
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Open CodeMini settings",
      "url": "/?action=settings"
    }
  ]
}
